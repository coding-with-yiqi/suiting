# 随听本机部署：复制为 .env 后填写；不要提交填写后的文件。
INSTALL_SORTFORMER=false
BACKEND_RELOAD=false
DATA_DIR=/app/data
BATCH_TRANSCRIBER_MODEL=local-whisper-base

# Docker Compose 本机默认值；建议自行设置密码。
# POSTGRES_USER=callhelper
# POSTGRES_PASSWORD=replace-with-your-own-password
# POSTGRES_DB=callhelper

# 模型密钥优先在应用的“连接 AI”里填写。
# GEMINI_API_KEY=
# OPENAI_API_KEY=
